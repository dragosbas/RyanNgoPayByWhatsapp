# PostgreSQL connection string. Copy this file to .env and point it at a database you control.
DATABASE_URL=postgresql://goodfund:goodfund@127.0.0.1:5432/goodfund

# Optional in-memory spam limit, counted separately for signup and unsubscribe.
# The counter lives in the server process and resets on restart.
# RATE_LIMIT_MAX=8
# RATE_LIMIT_WINDOW_MS=600000
